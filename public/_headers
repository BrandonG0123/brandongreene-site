# Cloudflare Pages / Netlify both read this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The site ships no third-party anything: no external scripts, no external
  # fonts, no analytics. This CSP says so, and will break loudly if that changes.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fonts are content-stable and self-hosted — cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
