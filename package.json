{
  "name": "brandongreene-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:a11y": "node scripts/a11y.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:budget": "node scripts/budget.mjs",
    "test:lighthouse": "lhci autorun",
    "test": "npm run build && npm run test:a11y && npm run test:links && npm run test:budget",
    "deploy": "./scripts/deploy.sh",
    "render:still": "node scripts/render-still.mjs",
    "render:models": "node scripts/render-model-stills.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "render:about": "node scripts/orbit-assets.mjs && astro build && node scripts/render-about-stills.mjs",
    "render:film": "cd video && npm install && npm run render"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3",
    "motion": "^14.0.0",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "satori": "^0.33.5",
    "typescript": "^6.0.3"
  }
}
