---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import Hero from '../components/Hero.astro';
import ServeChapter from '../components/ServeChapter.astro';
import { visibleProjects, visibleLog } from '../lib/visibility';

const all = await visibleProjects();
const logEntries = await visibleLog();

const featured = all
  .filter((p) => p.data.featured && p.data.status !== 'planned')
  .sort((a, b) => b.data.started.valueOf() - a.data.started.valueOf())
  .slice(0, 3);

const entryCounts = Object.fromEntries(
  all.map((p) => [p.id, logEntries.filter((e) => e.data.project === p.id).length])
);

// The hero's live readout: the most recently updated in-progress project. Only
// ever something that genuinely exists and is genuinely in progress.
const lastTouched = (slug: string, fallback: Date) => {
  const dates = logEntries.filter((e) => e.data.project === slug).map((e) => e.data.date.valueOf());
  return new Date(Math.max(fallback.valueOf(), ...dates));
};
const current = all
  .filter((p) => p.data.status === 'in-progress' && !p.data.placeholder)
  .map((p) => ({ p, when: lastTouched(p.id, p.data.updated ?? p.data.started) }))
  .sort((a, b) => b.when.valueOf() - a.when.valueOf())[0];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Brandon Greene',
  url: Astro.site?.href,
  jobTitle: 'Student',
  knowsAbout: ['Software engineering', 'Machine learning', 'Mathematics', '3D printing'],
};
---

<Base
  title="Brandon Greene"
  description="Projects in software, hardware and machine learning, each labelled by status and backed by a dated build log."
  jsonLd={jsonLd}
>
  <Hero
    title="I build hardware and software that has to work on something real."
    lede="Everything here is labelled by status and dated. If something isn't finished, the page says so and shows the work in progress instead of a promise."
    building={current && {
      title: current.p.data.title,
      href: `/projects/${current.p.id}`,
      updated: fmt(current.when),
    }}
  />

  <ServeChapter />

  <div class="wrap">


    <section id="work" aria-labelledby="featured-heading">
      <div class="section-head">
        <h2 id="featured-heading">Selected work</h2>
        <a href="/projects">All projects →</a>
      </div>

      {
        featured.length > 0 ? (
          <ProjectList projects={featured} entryCounts={entryCounts} />
        ) : (
          <p>No projects are published yet.</p>
        )
      }
    </section>

    <section aria-labelledby="log-heading">
      <div class="section-head">
        <h2 id="log-heading">Latest from the build log</h2>
        <a href="/log">Full log →</a>
      </div>
      <ul class="log-list">
        {
          logEntries
            .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
            .slice(0, 3)
            .map((e) => (
              <li class="log-entry">
                <time datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
                <h3>
                  <a href={`/log#${e.id}`}>{e.data.title}</a>
                </h3>
              </li>
            ))
        }
      </ul>
    </section>
  </div>
</Base>

