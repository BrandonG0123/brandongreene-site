---
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProjectList from '../../components/ProjectList.astro';
import { visibleProjects, visibleLog } from '../../lib/visibility';

const all = await visibleProjects();
const logEntries = await visibleLog();

const active = all
  .filter((p) => p.data.status !== 'planned')
  .sort((a, b) => b.data.started.valueOf() - a.data.started.valueOf());

// Planned work gets one line and no page. It never enters the main list.
const planned = all.filter((p) => p.data.status === 'planned');

const areas = [...new Set(active.flatMap((p) => p.data.areas))].sort();
const entryCounts = Object.fromEntries(
  all.map((p) => [p.id, logEntries.filter((e) => e.data.project === p.id).length])
);
---

<Base
  title="Projects"
  description="Everything Brandon Greene is building, labelled Shipped, In progress or Planned."
>
  <div class="wrap sheet">

    <div class="column">
      <h1>Projects</h1>
      <p>
        Every project here carries a status. <strong>Shipped</strong> means you can go and use it.{' '}
        <strong>In progress</strong> means it is genuinely unfinished, and the build log shows where
        it stands. <strong>Planned</strong> means it is an intention and nothing more, so it gets one
        line and no page.
      </p>

      {
        areas.length > 1 && (
          <div class="filters">
            <h2 class="mono-label" id="filter-heading" style="margin-bottom:0.75rem">
              Filter by area
            </h2>
            <div role="group" aria-labelledby="filter-heading" class="filter-buttons">
              <button type="button" data-area="all" aria-pressed="true">
                All
              </button>
              {areas.map((a) => (
                <button type="button" data-area={a} aria-pressed="false">
                  {a}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <p class="visually-hidden" role="status" data-filter-status></p>

      <ProjectList projects={active} entryCounts={entryCounts} />

      {
        planned.length > 0 && (
          <section aria-labelledby="planned-heading">
            <h2 id="planned-heading">Planned</h2>
            <p>Intentions, not work. Listed so the rest of the site can stay honest.</p>
            <ul class="planned-list">
              {planned.map((p) => (
                <li>
                  <StatusBadge status="planned" />
                  <span>{p.data.title}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="rail">
      <dl>
        <dt>Total</dt>
        <dd>{active.length} with pages</dd>
        <dt>Planned</dt>
        <dd>{planned.length} listed, no page</dd>
      </dl>
    </div>
  </div>
</Base>

<style>
  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .filter-buttons button {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: lowercase;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--rule);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }
  .filter-buttons button:hover { border-color: var(--accent); }
  /* Pressed state is a filled swatch AND the aria-pressed state, not colour alone. */
  .filter-buttons button[aria-pressed='true'] {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
</style>

<script>
  // Progressive enhancement: with JS off, every project is shown.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-buttons button');
  const items = document.querySelectorAll<HTMLLIElement>('[data-project-list] > li');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const area = btn.dataset.area!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

      let shown = 0;
      items.forEach((li) => {
        const match = area === 'all' || (li.dataset.areas ?? '').split(' ').includes(area);
        li.hidden = !match;
        if (match) shown++;
      });

      if (status) {
        status.textContent = `Showing ${shown} of ${items.length} projects${
          area === 'all' ? '' : ` in ${area}`
        }.`;
      }
    });
  });
</script>
