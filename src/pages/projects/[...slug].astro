---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import { visibleProjects } from '../../lib/visibility';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ModelViewer from '../../components/ModelViewer.astro';

export async function getStaticPaths() {
  // Planned projects never get a page. That is the whole point of the status.
  // Placeholders are stripped from production builds by visibleProjects().
  const projects = (await visibleProjects()).filter((p) => p.data.status !== 'planned');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

// "On this page": the case study's own sections, so a skimmer can jump straight
// to the evidence or to what went wrong.
const sections = headings.filter((h) => h.depth === 2);

// Reading time from the prose itself (HTML comments are notes, not content).
const words = (project.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/```[\s\S]*?```/g, '')
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const d = project.data;

const logEntries = (await getCollection('log', (e) => !e.data.draft))
  .filter((e) => e.data.project === project.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const lastUpdated = d.updated ?? logEntries[0]?.data.date ?? d.started;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  abstract: d.summary,
  dateCreated: d.started.toISOString().slice(0, 10),
  dateModified: lastUpdated.toISOString().slice(0, 10),
  creativeWorkStatus: d.status === 'shipped' ? 'Published' : 'Draft',
  author: { '@type': 'Person', name: 'Brandon Greene' },
};
---

<Base
  title={d.title}
  description={d.summary}
  noindex={d.draft || d.placeholder}
  jsonLd={jsonLd}
  ogSlug={project.id}
>
  <div class="wrap sheet">

    <article class="column">
      {
        d.placeholder && (
          <div class="draft-banner">
            <strong>Layout slot, not a project</strong>
            This page exists so the case study layout can be judged with realistic content. It
            renders in development only and is stripped from every production build. Fill in the
            fields and delete <code>placeholder: true</code> to turn it into a real project.
          </div>
        )
      }

      {
        d.draft && (
          <div class="draft-banner">
            <strong>Unpublished draft</strong>
            This page is not finished and is excluded from the site index, the sitemap and search
            engines. Remove <code>draft: true</code> from the markdown file to publish it.
          </div>
        )
      }

      <h1 style={`view-transition-name: title-${project.id}`}>{d.title}</h1>
      <p class="project-inline-meta">
        <StatusBadge status={d.status} />
        <span>Started {fmt(d.started)}</span>
      </p>

      <p class="lede" style="font-size:var(--step-1);line-height:1.5">{d.summary}</p>

      {d.model && <ModelViewer src={d.model.src} description={d.model.description} caption={d.model.caption} />}

      {
        d.hero && (
          <figure>
            {/* AVIF and WebP with a JPEG fallback, sized for the reading column
                at 1x and 2x. Dimensions come from the file, so no layout shift. */}
            <Picture
              src={d.hero.src}
              alt={d.hero.alt}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[528, 1056]}
              sizes="(min-width: 56.25rem) 33rem, 100vw"
              loading="eager"
              decoding="async"
            />
            {d.hero.caption && <figcaption class="mono-label">{d.hero.caption}</figcaption>}
          </figure>
        )
      }

      {
        d.aiAssisted && (
          <p class="mono-label" style="border:1px solid var(--hairline);padding:var(--space-3)">
            AI assistance: {d.aiAssisted}
          </p>
        )
      }

      <Content />

      {
        logEntries.length > 0 && (
          <section aria-labelledby="project-log">
            <h2 id="project-log">Build log</h2>
            <p>
              Dated entries for this project. {logEntries.length}{' '}
              {logEntries.length === 1 ? 'entry' : 'entries'} so far.
            </p>
            <ul class="log-list">
              {logEntries.map((e) => (
                <li class="log-entry">
                  <time datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
                  <h3>
                    <a href={`/log#${e.id}`}>{e.data.title}</a>
                  </h3>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <p style="margin-top:var(--space-7)"><a href="/projects">← All projects</a></p>
    </article>

    <aside class="rail" aria-labelledby="rail-heading">
      <h2 id="rail-heading" class="visually-hidden">Project details</h2>
      <dl>
        <dt>Status</dt>
        <dd><StatusBadge status={d.status} /></dd>

        <dt>Started</dt>
        <dd><time datetime={d.started.toISOString().slice(0, 10)}>{fmt(d.started)}</time></dd>

        <dt>Last updated</dt>
        <dd><time datetime={lastUpdated.toISOString().slice(0, 10)}>{fmt(lastUpdated)}</time></dd>

        <dt>Worked</dt>
        <dd>{d.collaboration === 'group' ? 'Group project' : 'Solo'}</dd>

        {d.role && (<dt>My part</dt><dd>{d.role}</dd>)}

        <dt>Areas</dt>
        <dd>{d.areas.join(', ')}</dd>

        {
          d.links.length > 0 && (
            <>
              <dt>Links</dt>
              <dd>
                <ul style="list-style:none;margin:0;padding:0;display:grid;gap:0.35rem">
                  {d.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </dd>
            </>
          )
        }
        <dt>Reading time</dt>
        <dd>About {minutes} min</dd>
      </dl>

      {
        sections.length > 2 && (
          <nav class="toc" aria-label="On this page">
            <p class="toc__title">On this page</p>
            <ol>
              {sections.map((h) => (
                <li>
                  <a href={`#${h.slug}`} data-toc>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </aside>
  </div>
</Base>

<script>
  // Highlight the section being read.
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  if (tocLinks.length) {
    const byId = new Map(tocLinks.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          tocLinks.forEach((a) => a.removeAttribute('aria-current'));
          byId.get((e.target as HTMLElement).id)?.setAttribute('aria-current', 'location');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    byId.forEach((_a, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }
</script>

<style>
  /* Wide screens: the project's 3D object stays pinned beside the text while you
     read, instead of scrolling away and leaving half the page empty. Text keeps
     its 65-character measure on the left. Below this width the viewer sits
     inline above the text, as before. */
  @media (min-width: 80rem) {
    .column:has(> :global(.viewer)) {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
      column-gap: clamp(var(--space-6), 4vw, var(--space-8));
      align-items: start;
    }
    .column:has(> :global(.viewer)) > * { grid-column: 1; }
    .column:has(> :global(.viewer)) > :global(.viewer) {
      grid-column: 2;
      grid-row: 1 / span 80;
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
      margin: 0;
    }
    .column:has(> :global(.viewer)) :global(.viewer__stage) { aspect-ratio: 1 / 1; }
    /* Narrow side column: hint on its own line, both buttons together below. */
    .column:has(> :global(.viewer)) :global(.viewer__hint) { flex-basis: 100%; }
  }

  /* On narrow screens the rail sits below the article, where an index of the
     page above is no use — so it only appears beside the text. */
  .toc { display: none; }
  @media (min-width: 56.25rem) {
    .toc {
      display: block;
      margin-top: var(--space-6);
      padding-top: var(--space-4);
      border-top: 1px solid var(--hairline);
      border-top: 1px solid color-mix(in srgb, var(--rule) 50%, transparent);
    }
  }
  .toc__title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); }
  .toc a {
    display: block;
    padding: var(--space-1) 0 var(--space-1) var(--space-3);
    border-left: 2px solid var(--hairline);
    border-left: 2px solid color-mix(in srgb, var(--rule) 40%, transparent);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 0.2s, border-color 0.3s;
  }
  .toc a:hover { color: var(--fg); }
  .toc a[aria-current] { color: var(--fg); border-left-color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .toc a { transition: none; } }
</style>
