---
/**
 * A slim chapter indicator at the right edge of the home page: where you are
 * in the scroll, and a way to jump. A reader with sixty seconds can skip the
 * cinematic opening straight to the work.
 *
 * Wide screens only (it would crowd a phone). Appears once the reader leaves
 * the hero, so the first impression stays clean. Plain links: works without
 * JavaScript, and the active chapter is exposed with aria-current.
 */
const chapters = [
  { id: 'origin', num: '01', name: 'Origin' },
  { id: 'work', num: '02', name: 'Work' },
  { id: 'log', num: '03', name: 'Build log' },
  { id: 'elsewhere', num: '04', name: 'Elsewhere' },
];
---

<nav class="chapters" aria-label="Page chapters" data-chapters>
  <ol>
    {
      chapters.map((c) => (
        <li>
          <a href={`#${c.id}`} data-chapter={c.id}>
            <span class="chapters__num">{c.num}</span>
            <span class="chapters__tick" aria-hidden="true" />
            <span class="chapters__name">{c.name}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[data-chapters]');
  const links = [...(rail?.querySelectorAll<HTMLAnchorElement>('[data-chapter]') ?? [])];
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (rail && links.length) {
    // Show the rail once the hero is mostly gone.
    if (hero) {
      new IntersectionObserver(([e]) => rail.classList.toggle('is-shown', e.intersectionRatio < 0.4), {
        threshold: [0, 0.4, 1],
      }).observe(hero);
    } else {
      rail.classList.add('is-shown');
    }

    // Scroll-spy: the chapter crossing the middle of the screen is current.
    const sections = links
      .map((a) => document.getElementById(a.dataset.chapter!))
      .filter((s): s is HTMLElement => !!s);
    const setCurrent = (id: string) =>
      links.forEach((a) => (a.dataset.chapter === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setCurrent((e.target as HTMLElement).id);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .chapters {
    display: none;
  }
  /* Only where the page margin is wide enough to hold it without touching the
     content (88rem frame + room for the rail). */
  @media (min-width: 88rem) and (hover: hover) {
    .chapters {
      display: block;
      position: fixed;
      right: var(--space-3);
      top: 50%;
      z-index: 40;
      transform: translate(0.75rem, -50%);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    }
    .chapters.is-shown,
    .chapters:focus-within {
      opacity: 1;
      transform: translate(0, -50%);
      pointer-events: auto;
    }
  }

  /* A small glass backing: full-bleed sections (the serve, the word band) pass
     under the rail, and the ticks must stay legible over them. */
  .chapters ol {
    list-style: none;
    margin: 0;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-1);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    display: grid;
    gap: var(--space-1);
    justify-items: end;
  }

  .chapters a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: 0 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
    flex-direction: row-reverse;
  }

  .chapters__tick {
    width: 0.9rem;
    height: 1px;
    background: var(--rule);
    transition: width 0.4s var(--ease-out), background 0.3s;
  }
  .chapters__name {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.45s var(--ease-out), opacity 0.3s;
  }

  /* Names only on hover/focus: a persistent label would reach into the content. */
  .chapters a:hover .chapters__name,
  .chapters a:focus-visible .chapters__name {
    max-width: 8rem;
    opacity: 1;
  }
  .chapters a[aria-current] { color: var(--fg); }
  .chapters a[aria-current] .chapters__num { color: var(--accent); }
  .chapters a[aria-current] .chapters__tick,
  .chapters a:hover .chapters__tick {
    width: 1.25rem;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .chapters, .chapters__tick, .chapters__name { transition: none; }
  }
</style>
