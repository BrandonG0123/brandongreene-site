---
/**
 * An orbitable 3D model with a caption that carries the same information in
 * words. three.js is loaded only when this scrolls near the viewport, so the
 * page's text is never waiting on it.
 */
interface Props {
  src: string;
  /** What the object is, for screen readers. Read in place of the canvas. */
  description: string;
  /** Visible caption: what the object is and why it matters. */
  caption: string;
}
const { src, description, caption } = Astro.props;
---

<figure class="viewer" data-viewer data-src={src}>
  <div class="viewer__stage">
    <canvas
      class="viewer__canvas"
      tabindex="0"
      role="img"
      aria-roledescription="interactive 3D model"
      aria-label={`${description} Use the left and right arrow keys to turn it, up and down to tilt, Home to reset.`}
    ></canvas>
    <p class="viewer__state viewer__state--loading" aria-hidden="true">Loading model</p>
    <p class="viewer__state viewer__state--failed">The 3D preview can't run in this browser. The caption below describes the object.</p>
  </div>

  <div class="viewer__bar">
    <span class="viewer__hint" aria-hidden="true">Drag or use arrow keys to turn</span>
    <button type="button" class="viewer__btn" data-viewer-reset>Reset view</button>
    <button type="button" class="viewer__btn" data-viewer-pause aria-pressed="false">Pause rotation</button>
  </div>

  <figcaption class="viewer__caption">{caption}</figcaption>
  <p class="visually-hidden" role="status" data-viewer-status></p>
</figure>

<script>
  for (const host of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const load = () =>
      import('../scripts/viewer').then((m) => m.mountViewer(host)).catch(() => host.classList.add('viewer--failed'));
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        'requestIdleCallback' in window ? (window as any).requestIdleCallback(load, { timeout: 800 }) : setTimeout(load, 100);
      },
      { rootMargin: '300px' },
    );
    io.observe(host);
  }
</script>

<style>
  .viewer {
    margin: var(--space-6) 0;
  }

  .viewer__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    max-width: 100%;
    border: 1px solid color-mix(in srgb, var(--rule) 60%, transparent);
    background:
      radial-gradient(60% 70% at 50% 60%, color-mix(in srgb, var(--ice) 8%, transparent), transparent 70%),
      linear-gradient(180deg, var(--surface), var(--bg));
    overflow: hidden;
  }
  /* corner ticks, like a CAD viewport */
  .viewer__stage::before,
  .viewer__stage::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    border-style: solid;
    pointer-events: none;
    opacity: 0.7;
  }
  .viewer__stage::before { top: 8px; left: 8px; border-width: 1px 0 0 1px; }
  .viewer__stage::after { bottom: 8px; right: 8px; border-width: 0 1px 1px 0; }

  .viewer__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    opacity: 0;
    transition: opacity 0.9s var(--ease-out);
  }
  .viewer__canvas:active { cursor: grabbing; }
  .viewer__canvas:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  :global(.viewer--ready) .viewer__canvas { opacity: 1; }

  .viewer__state {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-5);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .viewer__state--loading::after {
    content: '';
    display: block;
    width: 6rem;
    height: 1px;
    margin-top: var(--space-3);
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    animation: scanbar 1.4s ease-in-out infinite;
  }
  @keyframes scanbar { 0%, 100% { transform: scaleX(0.2); } 50% { transform: scaleX(1); } }
  :global(.viewer--ready) .viewer__state--loading,
  .viewer__state--failed { display: none; }
  :global(.viewer--failed) .viewer__state--failed { display: grid; }
  :global(.viewer--failed) .viewer__state--loading,
  :global(.viewer--failed) .viewer__bar button,
  :global(.viewer--failed) .viewer__hint { display: none; }

  .viewer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .viewer__hint {
    margin-right: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .viewer__btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--rule);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    cursor: pointer;
  }
  .viewer__btn:hover { border-color: var(--accent); color: var(--accent); }

  .viewer__caption {
    margin-top: var(--space-3);
    color: var(--fg-muted);
    font-size: var(--step--1);
    line-height: 1.55;
    max-width: var(--measure);
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer__canvas { transition: none; }
    .viewer__state--loading::after { animation: none; }
  }
</style>
