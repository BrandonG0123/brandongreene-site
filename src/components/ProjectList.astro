---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** slug -> number of log entries, used as the In-progress evidence. */
  entryCounts?: Record<string, number>;
}

const { projects, entryCounts = {} } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<ul class="project-index" data-project-list>
  {
    projects.map((p) => {
      const count = entryCounts[p.id] ?? 0;
      return (
        <li data-areas={p.data.areas.join(' ')}>
          <article class="project-row">
            <div class="project-row__main">
              <h3 class="project-row__title">
                <a href={`/projects/${p.id}`}>{p.data.title}</a>
              </h3>
              <p class="project-row__summary">{p.data.summary}</p>
            </div>

            <div class="project-row__meta">
              <StatusBadge
                status={p.data.status}
                detail={
                  p.data.status === 'in-progress' && count > 0
                    ? `${count} log ${count === 1 ? 'entry' : 'entries'}`
                    : undefined
                }
              />
              <span class="project-row__date">
                <span class="visually-hidden">Started </span>
                {fmt(p.data.started)}
              </span>
              <span class="project-row__areas">{p.data.areas.join(' · ')}</span>
              {p.data.collaboration === 'group' && (
                <span class="project-row__group">Group project</span>
              )}
            </div>

            {p.data.placeholder && (
              <p class="placeholder-flag">
                Placeholder slot — dev only, stripped from every production build
              </p>
            )}
          </article>
        </li>
      );
    })
  }
</ul>
