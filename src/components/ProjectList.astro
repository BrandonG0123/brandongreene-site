---
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** slug -> number of log entries, used as the In-progress evidence. */
  entryCounts?: Record<string, number>;
}

const { projects, entryCounts = {} } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });

// A still of the project's 3D model, rendered offline from its real viewer by
// `npm run render:models`. Only shown if it exists.
const still = (slug: string) =>
  fs.existsSync(path.join(process.cwd(), 'public/models/stills', `${slug}.webp`)) ? `/models/stills/${slug}` : null;
---

<ul class="project-index" data-project-list>
  {
    projects.map((p, i) => {
      const count = entryCounts[p.id] ?? 0;
      const media = still(p.id);
      return (
        <li data-areas={p.data.areas.join(' ')}>
          {/* The whole card is clickable via a stretched link on the title, so
              there is exactly one link per card for keyboard and screen-reader
              users, not an outer <a> wrapping block content. */}
          <article class:list={['card', { 'card--media': media }]} data-card>
            {/* Decorative: the card's text says what the project is; the model is
                described in full, with its own caption, on the project page. */}
            {media && (
              <div
                class="card__media"
                aria-hidden="true"
                data-card-media
                data-src={p.data.model?.src}
              >
                <picture>
                  <source srcset={`${media}.avif`} type="image/avif" />
                  <img src={`${media}.webp`} alt="" width="1200" height="750" loading="lazy" decoding="async" />
                </picture>
                {/* The live model crossfades in over the still on first mouse
                    movement; until then — and for touch, reduced motion, or no
                    JavaScript — the still is the whole story. */}
                {p.data.model && <canvas class="card__live" />}
                <span class="card__scan" />
              </div>
            )}
            <span class="card__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

            <div class="card__main">
              <h3 class="card__title" style={`view-transition-name: title-${p.id}`}>
                <a class="card__link" href={`/projects/${p.id}`}>{p.data.title}</a>
              </h3>
              <p class="card__summary">{p.data.summary}</p>
            </div>

            <div class="card__meta">
              <StatusBadge
                status={p.data.status}
                detail={
                  p.data.status === 'in-progress' && count > 0
                    ? `${count} log ${count === 1 ? 'entry' : 'entries'}`
                    : undefined
                }
              />
              <span>
                <span class="visually-hidden">Started </span>
                {fmt(p.data.started)}
              </span>
              <span>{p.data.areas.join(' · ')}</span>
              {p.data.collaboration === 'group' && <span>Group project</span>}
            </div>

            <span class="card__arrow" aria-hidden="true">↗</span>

            {p.data.placeholder && (
              <p class="placeholder-flag">
                Placeholder slot — dev only, stripped from every production build
              </p>
            )}
          </article>
        </li>
      );
    })
  }
</ul>

<script>
  import { initCards } from '../scripts/cards';
  initCards();
</script>

<style>
  /* Two-up on wide screens; the first card spans the full width so the most
     recent work leads. One column on narrow screens. */
  .project-index {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: var(--space-5);
    perspective: 1400px;
    /* Cards lay themselves out by the width of THIS list, not the viewport:
       the same list sits full-width on the home page and in a narrower column
       on /projects. */
    container-type: inline-size;
    container-name: projects;
  }
  .project-index > li:first-child:not(:only-child) { grid-column: 1 / -1; }
  .project-index > li { display: grid; }
  .project-index > li:first-child:not(:only-child) .card { padding-block: var(--space-6); }
  .project-index > li:first-child:not(:only-child) .card__title { font-size: var(--step-3); }

  @container projects (min-width: 52rem) {
    /* Text centred vertically against the object: rows 2-3 between two
       flexible spacer rows. */
    .project-index > li:first-child .card--media,
    .project-index > li:only-child .card--media {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-rows: 1fr auto auto 1fr;
      column-gap: var(--space-6);
      align-items: start;
      min-height: 22rem;
    }
    .project-index > li:first-child .card--media .card__index,
    .project-index > li:only-child .card--media .card__index { grid-row: 2; }
    .project-index > li:first-child .card--media .card__main,
    .project-index > li:only-child .card--media .card__main { grid-column: 2; grid-row: 2; }
    .project-index > li:first-child .card--media .card__meta,
    .project-index > li:only-child .card--media .card__meta { grid-row: 3; }
    .project-index > li:first-child .card--media .card__media,
    .project-index > li:only-child .card--media .card__media {
      grid-column: 3;
      grid-row: 1 / span 4;
      margin-bottom: 0;
      align-self: stretch;
      aspect-ratio: auto;
      min-height: 100%;
    }
    .project-index > li:first-child .card--media .card__arrow,
    .project-index > li:only-child .card--media .card__arrow { display: none; }
  }

  .card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3) var(--space-5);
    padding: var(--space-5) var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid color-mix(in srgb, var(--rule) 55%, transparent);
    background:
      radial-gradient(420px circle at var(--mx) var(--my), color-mix(in srgb, var(--ice) 11%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 92%, transparent), color-mix(in srgb, var(--bg) 92%, transparent));
    transform-style: preserve-3d;
    transition: border-color 0.3s, box-shadow 0.4s var(--ease-out);
    will-change: transform;
  }
  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent),
      0 1.5rem 3rem -1.5rem color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* ---- media: the project's 3D object, as a hologram still ---- */
  .card__media {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--rule) 45%, transparent);
    background: var(--bg);
    aspect-ratio: 16 / 10;
    max-width: 100%;
  }
  /* The still is framed for the wide viewer; crop in on the object. */
  .card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
    transform: scale(1.32);
    transition: transform 1.2s var(--ease-out), filter 0.6s;
    filter: saturate(0.9) brightness(0.92);
  }
  .card:hover .card__media img,
  .card:focus-within .card__media img {
    transform: scale(1.4);
    filter: saturate(1.1) brightness(1.05);
  }
  /* Live model: sits over the still and fades in once it has rendered. */
  .card__live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }
  .card__media:global(.viewer--ready) .card__live { opacity: 1; }
  .card__media:global(.viewer--ready) picture { opacity: 0; transition: opacity 1s var(--ease-out); }
  /* The live shader draws its own scan line; drop the CSS one. */
  .card__media:global(.viewer--ready) .card__scan { display: none; }

  /* A scan line sweeps the still on hover — the same gesture as the viewer. */
  .card__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, color-mix(in srgb, var(--ice) 32%, transparent) 50%, transparent 52%);
    background-size: 100% 220%;
    background-position: 0 -120%;
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .card:hover .card__scan,
  .card:focus-within .card__scan {
    opacity: 1;
    animation: card-scan 1.6s var(--ease-out) infinite;
  }
  @keyframes card-scan {
    from { background-position: 0 -120%; }
    to { background-position: 0 120%; }
  }

  /* Cards with media: image across the top on small cards. */
  .card--media { grid-template-columns: auto minmax(0, 1fr); }
  .card--media .card__media { grid-column: 1 / -1; margin-bottom: var(--space-3); }

  .card__index {
    grid-row: span 2;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-muted);
    padding-top: 0.45rem;
    min-width: 2ch;
  }

  .card__title {
    font-size: var(--step-2);
    line-height: 1.12;
    margin: 0 0 var(--space-2);
  }
  .card__link {
    color: var(--fg);
    text-decoration: none;
  }
  /* Stretch the one link over the whole card. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card__link:focus-visible { outline: none; }
  .card:has(.card__link:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .card__summary {
    margin: 0;
    color: var(--fg-muted);
    max-width: 40rem;
  }

  .card__meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }

  .card__arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--fg-muted);
    transition: transform 0.4s var(--ease-out), color 0.3s;
  }
  .card:hover .card__arrow,
  .card:focus-within .card__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .placeholder-flag { grid-column: 2; position: relative; z-index: 2; }

  /* Narrow lists — phones, or a narrow column: one column, everything stacked.
     A container query for the same reason as the split layout above. */
  @container projects (max-width: 34rem) {
    .card,
    .card--media {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-5) var(--space-6) var(--space-5) var(--space-4);
    }
    .card__index { grid-row: auto; padding-top: 0; }
    /* the corner arrow would sit on the image's frame */
    .card--media .card__arrow { display: none; }
    .card__index,
    .card__main,
    .card__meta,
    .card__media,
    .placeholder-flag { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card__arrow, .card__media img { transition: none; }
    .card:hover .card__arrow, .card:hover .card__media img { transform: none; }
    .card:hover .card__scan, .card:focus-within .card__scan { animation: none; opacity: 0; }
  }
</style>
