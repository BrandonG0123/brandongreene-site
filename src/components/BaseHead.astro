---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Omit on pages that must not be indexed (drafts). */
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  /** Project slug, to use that project's generated card. Defaults to the site card. */
  ogSlug?: string;
}

const { title, description, noindex = false, jsonLd, ogSlug } = Astro.props;

// FAILS CLOSED. The site is hidden from search unless a build explicitly sets
// PUBLIC_ALLOW_INDEXING=true. It used to be the other way round — opt out with
// =false — and tank's automated build simply never set it, so the site went
// live indexable with fill-in markers on /about and /resume. A switch that only
// works if every build environment remembers it is not a switch.
// Launch = build with PUBLIC_ALLOW_INDEXING=true. See DEPLOY.md.
const siteBlocked = import.meta.env.PUBLIC_ALLOW_INDEXING !== 'true';
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(`/og/${ogSlug ?? 'default'}.png`, Astro.site);
const fullTitle = title === 'Brandon Greene' ? title : `${title} — Brandon Greene`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#FAF7F2" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#15171A" media="(prefers-color-scheme: dark)" />
{(noindex || siteBlocked) && <meta name="robots" content="noindex, nofollow" />}

<!-- Body and display faces preloaded; they are the render-critical pair. -->
<link
  rel="preload"
  href="/fonts/AtkinsonHyperlegibleNext-latin-400.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="preload" href="/fonts/Fraunces-latin-700.woff2" as="font" type="font/woff2" crossorigin />

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content="Brandon Greene" />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title} — ${canonical.hostname}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<link rel="alternate" type="application/rss+xml" title="Brandon Greene — build log" href="/rss.xml" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<!-- Sets the theme before first paint so there is no flash. Kept inline and tiny. -->
<script is:inline>
  (() => {
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    } catch (e) {
      /* private mode or blocked storage — fall back to the OS setting */
    }
  })();
</script>
